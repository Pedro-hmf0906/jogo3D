# Nave low-poly feita a mao (apontando para -Z)
# Este arquivo NAO tem normais (vn): o leitor calcula a normal de cada face.

# fuselagem
v 0.0 0.0 -1.5
v -0.5 0.25 1.0
v 0.5 0.25 1.0
v 0.5 -0.25 1.0
v -0.5 -0.25 1.0
# asa direita
v 0.4 0.0 -0.3
v 2.0 0.0 0.9
v 0.4 0.0 0.9
# asa esquerda
v -0.4 0.0 -0.3
v -2.0 0.0 0.9
v -0.4 0.0 0.9

# fuselagem: topo, direita, base, esquerda, traseira (quadrado)
f 1 2 3
f 1 3 4
f 1 4 5
f 1 5 2
f 2 5 4 3

# asa direita (face de cima e de baixo)
f 6 8 7
f 6 7 8

# asa esquerda (face de cima e de baixo)
f 9 10 11
f 9 11 10
